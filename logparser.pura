static inline def bigram_idx(c0: u8, c1: u8) -> u16:
    return u16(((u32(c0) * 131U) ^ u32(c1)) & 4095U)

static def init_rule_slices(arena: addr[Arena], rule: addr[UaRule]):
    if rule.hint_len >= 2:
        arr: addr[HintSlice] = cast(addr[HintSlice], arena_alloc(arena, sizeof(HintSlice)))
        hl: i32 = i32(rule.hint_len)
        arr[0].ptr = rule.hint
        arr[0].len = hl
        arr[0].bg0 = bigram_idx(u8(rule.hint[0]), u8(rule.hint[1]))
        arr[0].bg1 = bigram_idx(u8(rule.hint[hl - 2]), u8(rule.hint[hl - 1]))
        rule.slices = arr
        rule.n_slices = 1
        return
    s: cstr = rule.any_hints
    if s == nil:
        rule.n_slices = -1
        return
    count: i32 = 1
    p: cstr = s
    while val(p) != '\0':
        if val(p) == '\n':
            count += 1
        p += 1
    arr: addr[HintSlice] = cast(addr[HintSlice], arena_alloc(arena, usize(count) * sizeof(HintSlice)))
    idx: i32 = 0
    cur: cstr = s
    while true:
        nl: cstr = strchr(cur, '\n')
        wlen: i32 = i32(strlen(cur)) if nl == nil else i32(nl - cur)
        arr[idx].ptr = cur
        arr[idx].len = wlen
        if wlen >= 2:
            arr[idx].bg0 = bigram_idx(u8(cur[0]), u8(cur[1]))
            arr[idx].bg1 = bigram_idx(u8(cur[wlen - 2]), u8(cur[wlen - 1]))
        else:
            arr[idx].bg0 = 0
            arr[idx].bg1 = 0
        idx += 1
        if nl == nil:
            break
        cur = nl + 1
    rule.slices = arr
    rule.n_slices = idx

static inline def contains_hint(hay: cstr, hlen: i32, needle: cstr, nlen: i32, icase: bool) -> bool:
    if nlen == 0:
        return true
    if hlen < nlen:
        return false
    if not icase:
        if nlen == 1:
            return memchr(hay, needle[0], usize(hlen)) != nil
        first: char = needle[0]
        p: cstr = hay
        rem: i32 = hlen - nlen + 1
        while rem > 0:
            m: cstr = cast(cstr, memchr(p, first, usize(rem)))
            if m == nil:
                return false
            if memcmp(m, needle, usize(nlen)) == 0:
                return true
            adv: i32 = i32(m - p) + 1
            p += adv
            rem -= adv
        return false
    # Case-insensitive substring search
    f_lo: u8 = u8(tolower(u8(needle[0])))
    limit: i32 = hlen - nlen + 1
    for i in range(limit):
        if u8(tolower(u8(hay[i]))) == f_lo:
            ok: bool = true
            for j in range(1, nlen):
                if u8(tolower(u8(hay[i + j]))) != u8(tolower(u8(needle[j]))):
                    ok = false
                    break
            if ok:
                return true
    return false

static inline def rule_hint_ok(arena: addr[Arena], rule: addr[UaRule],
                               ua_low: cstr, ulen: i32, bg: addr[u64]) -> bool:
    if rule.n_slices == 0:
        init_rule_slices(arena, rule)
    if rule.n_slices < 0:
        return true
    for si in range(rule.n_slices):
        sl: HintSlice = rule.slices[si]
        if (bg[sl.bg0 >> 6] & (u64(1) << (sl.bg0 & 63))) == 0:
            continue
        if (bg[sl.bg1 >> 6] & (u64(1) << (sl.bg1 & 63))) == 0:
            continue
        if contains_hint(ua_low, ulen, sl.ptr, sl.len, false):
            return true
    return false

static def apply_rep(rep: cstr, ua: cstr, s1: i32, e1: i32, out: str, out_cap: i32) -> u32:
    if rep == nil:
        if s1 >= 0 and e1 >= s1:
            n: i32 = e1 - s1
            if n >= out_cap:
                n = out_cap - 1
            memcpy(out, ua + s1, usize(n))
            out[n] = '\0'
            return u32(n)
        memcpy(out, "Other", 6)
        return 5
    dollar: cstr = strstr(rep, "$1")
    if dollar == nil:
        n: i32 = i32(strlen(rep))
        if n >= out_cap:
            n = out_cap - 1
        memcpy(out, rep, usize(n))
        out[n] = '\0'
        return u32(n)
    pre: i32 = i32(dollar - rep)
    g1: i32 = (e1 - s1) if (s1 >= 0 and e1 >= s1) else 0
    post: i32 = i32(strlen(dollar + 2))
    pos: i32 = 0
    for i in range(pre):
        if pos + 1 < out_cap:
            out[pos] = rep[i]
            pos += 1
    for i in range(g1):
        if pos + 1 < out_cap:
            out[pos] = ua[s1 + i]
            pos += 1
    for i in range(post):
        if pos + 1 < out_cap:
            out[pos] = dollar[2 + i]
            pos += 1
    out[pos] = '\0'
    return u32(pos)

static def is_extra_bot(browser: cstr, blen: u32) -> bool:
    extra_bots: cstr[13] = {
        "Amazonbot", "Applebot", "Bytespider", "FacebookBot", "Twitterbot",
        "FriendlyCrawler", "ISSCyberRiskCrawler", "YisouSpider",
        "Go-http-client", "http.rb", "scalaj-http",
        "Python aiohttp", "Python Requests"
    }
    for i in range(13):
        if strlen(extra_bots[i]) == usize(blen) and memcmp(browser, extra_bots[i], usize(blen)) == 0:
            return true
    return false

struct UaCacheEntry:
    hash: u64
    ua: cstr
    ua_len: u32
    browser: cstr
    browser_len: u32
    os: cstr
    os_len: u32
    is_bot: bool

struct UaCache:
    buckets: addr[u32]
    mask: usize
    entries: addr[UaCacheEntry]
    count: u32
    cap: u32
    arena: addr[Arena]
    intern: addr[StrInterner]

static def uacache_init(c: addr[UaCache], arena: addr[Arena], intern: addr[StrInterner]):
    c.arena = arena
    c.intern = intern
    c.mask = 65536 - 1
    c.buckets = cast(addr[u32], calloc(65536, sizeof(u32)))
    c.cap = 8192
    c.count = 0
    c.entries = cast(addr[UaCacheEntry], malloc(usize(c.cap) * sizeof(UaCacheEntry)))

static def uacache_free(c: addr[UaCache]):
    free(c.buckets)
    free(c.entries)

static def uacache_rehash(c: addr[UaCache]):
    new_n: usize = (c.mask + 1) * 2
    nb: addr[u32] = cast(addr[u32], calloc(new_n, sizeof(u32)))
    nmask: usize = new_n - 1
    for idx: u32 in range(c.count):
        slot: usize = usize(c.entries[idx].hash) & nmask
        while nb[slot] != 0:
            slot = (slot + 1) & nmask
        nb[slot] = idx + 1
    free(c.buckets)
    c.buckets = nb
    c.mask = nmask

static inline def uacache_get(c: addr[UaCache], ua: cstr, ulen: u32) -> addr[UaCacheEntry]:
    h: u64 = hash_bytes(ua, usize(ulen))
    slot: usize = usize(h) & c.mask
    while c.buckets[slot] != 0:
        idx: u32 = c.buckets[slot] - 1
        if c.entries[idx].hash == h and c.entries[idx].ua_len == ulen and (ulen == 0 or memcmp(c.entries[idx].ua, ua, usize(ulen)) == 0):
            return c.entries[idx].addr
        slot = (slot + 1) & c.mask

    # Parse UA on cache miss — lowercase once and build 4096-bit bigram filter
    ua_low_buf: char[2048]
    ulen_i: i32 = i32(ulen)
    if ulen_i > 2047:
        ulen_i = 2047
    for k in range(ulen_i):
        ch: u8 = u8(ua[k])
        if ch >= 'A' and ch <= 'Z':
            ua_low_buf[k] = char(ch + 32)
        else:
            ua_low_buf[k] = char(ch)
    ua_low_buf[ulen_i] = '\0'

    bg: u64[64]
    memset(bg, 0, sizeof(bg))
    for k in range(ulen_i - 1):
        b_idx: u16 = bigram_idx(u8(ua_low_buf[k]), u8(ua_low_buf[k + 1]))
        bg[b_idx >> 6] |= (u64(1) << (b_idx & 63))

    b_buf: char[256]
    b_len: u32 = 5
    memcpy(b_buf, "Other", 6)
    n_ua: i32 = i32(sizeof(UA_RULES) / sizeof(UaRule))
    for i in range(n_ua):
        rule: addr[UaRule] = UA_RULES[i].addr
        if not rule_hint_ok(c.arena, rule, ua_low_buf, ulen_i, bg):
            continue
        if rule.prog == nil:
            rule.prog = compile_regex(c.arena, rule.pattern, rule.icase)
        s1: i32 = -1
        e1: i32 = -1
        if vm_exec(rule.prog, ua, i32(ulen), s1.addr, e1.addr):
            b_len = apply_rep(rule.rep, ua, s1, e1, b_buf, 256)
            break

    is_bot: bool = is_extra_bot(b_buf, b_len)
    if not is_bot:
        n_dev: i32 = i32(sizeof(DEV_RULES) / sizeof(UaRule))
        decided: bool = false
        for i in range(6):
            rule: addr[UaRule] = DEV_RULES[i].addr
            if not rule_hint_ok(c.arena, rule, ua_low_buf, ulen_i, bg):
                continue
            if rule.prog == nil:
                rule.prog = compile_regex(c.arena, rule.pattern, rule.icase)
            s1: i32 = -1
            e1: i32 = -1
            if vm_exec(rule.prog, ua, i32(ulen), s1.addr, e1.addr):
                is_bot = true
                decided = true
                break
        if not decided and n_dev > 6:
            sp_rule: addr[UaRule] = DEV_RULES[n_dev - 1].addr
            if rule_hint_ok(c.arena, sp_rule, ua_low_buf, ulen_i, bg):
                if sp_rule.prog == nil:
                    sp_rule.prog = compile_regex(c.arena, sp_rule.pattern, sp_rule.icase)
                s1: i32 = -1
                e1: i32 = -1
                if vm_exec(sp_rule.prog, ua, i32(ulen), s1.addr, e1.addr):
                    shadowed: bool = false
                    for i in range(6, n_dev - 1):
                        rule: addr[UaRule] = DEV_RULES[i].addr
                        if not rule_hint_ok(c.arena, rule, ua_low_buf, ulen_i, bg):
                            continue
                        if rule.prog == nil:
                            rule.prog = compile_regex(c.arena, rule.pattern, rule.icase)
                        if vm_exec(rule.prog, ua, i32(ulen), s1.addr, e1.addr):
                            shadowed = true
                            break
                    if not shadowed:
                        is_bot = true

    o_buf: char[256]
    o_len: u32 = 5
    memcpy(o_buf, "Other", 6)
    if not is_bot:
        n_os: i32 = i32(sizeof(OS_RULES) / sizeof(UaRule))
        for i in range(n_os):
            rule: addr[UaRule] = OS_RULES[i].addr
            if not rule_hint_ok(c.arena, rule, ua_low_buf, ulen_i, bg):
                continue
            if rule.prog == nil:
                rule.prog = compile_regex(c.arena, rule.pattern, rule.icase)
            s1: i32 = -1
            e1: i32 = -1
            if vm_exec(rule.prog, ua, i32(ulen), s1.addr, e1.addr):
                o_len = apply_rep(rule.rep, ua, s1, e1, o_buf, 256)
                break

    if usize(c.count + 1) * 10 >= (c.mask + 1) * 7:
        uacache_rehash(c)
        slot = usize(h) & c.mask
        while c.buckets[slot] != 0:
            slot = (slot + 1) & c.mask
    if c.count == c.cap:
        c.cap *= 2
        c.entries = cast(addr[UaCacheEntry], realloc(c.entries, usize(c.cap) * sizeof(UaCacheEntry)))

    intern: addr[StrInterner] = c.intern
    bid: u32 = intern_str(intern, b_buf, b_len)
    oid: u32 = intern_str(intern, o_buf, o_len)
    id: u32 = c.count
    c.count += 1
    c.entries[id].hash = h
    c.entries[id].ua = arena_strdup(c.arena, ua, usize(ulen))
    c.entries[id].ua_len = ulen
    c.entries[id].browser = intern.entries[bid].s
    c.entries[id].browser_len = b_len
    c.entries[id].os = intern.entries[oid].s
    c.entries[id].os_len = o_len
    c.entries[id].is_bot = is_bot
    c.buckets[slot] = id + 1
    return c.entries[id].addr

# -------------------------------------------------------------------------
# Referrer URL & Hostname Extraction + Skip Cache
# -------------------------------------------------------------------------

struct RefCacheEntry:
    hash: u64
    raw: cstr
    raw_len: u32
    link: cstr
    link_len: u32
    skip: bool

struct RefCache:
    buckets: addr[u32]
    mask: usize
    entries: addr[RefCacheEntry]
    count: u32
    cap: u32
    arena: addr[Arena]
    skips: addr[cstr]
    n_skips: i32

static def refcache_init(c: addr[RefCache], arena: addr[Arena], skips: addr[cstr], n_skips: i32):
    c.arena = arena
    c.skips = skips
    c.n_skips = n_skips
    c.mask = 65536 - 1
    c.buckets = cast(addr[u32], calloc(65536, sizeof(u32)))
    c.cap = 8192
    c.count = 0
    c.entries = cast(addr[RefCacheEntry], malloc(usize(c.cap) * sizeof(RefCacheEntry)))

static def refcache_free(c: addr[RefCache]):
    free(c.buckets)
    free(c.entries)

static def refcache_rehash(c: addr[RefCache]):
    new_n: usize = (c.mask + 1) * 2
    nb: addr[u32] = cast(addr[u32], calloc(new_n, sizeof(u32)))
    nmask: usize = new_n - 1
    for idx: u32 in range(c.count):
        slot: usize = usize(c.entries[idx].hash) & nmask
        while nb[slot] != 0:
            slot = (slot + 1) & nmask
        nb[slot] = idx + 1
    free(c.buckets)
    c.buckets = nb
    c.mask = nmask

static inline def is_scheme_char(ch: char) -> bool:
    return (ch >= 'a' and ch <= 'z') or (ch >= '0' and ch <= '9') or ch == '+' or ch == '-' or ch == '.'

static def parse_ref_link_and_host(low: cstr, len: i32, link_out: str, link_len_out: addr[u32],
                                   host_out: str, host_len_out: addr[u32]):
    # Mimic urllib.parse.urlparse + tldextract-style hostname normalization
    netloc: cstr = ""
    nlen: i32 = 0
    rest: cstr = low
    rlen: i32 = len
    has_scheme: bool = false
    uses_params: bool = true

    if len > 0 and low[0] >= 'a' and low[0] <= 'z':
        i: i32 = 1
        while i < len and is_scheme_char(low[i]):
            i += 1
        if i < len and low[i] == ':':
            has_scheme = true
            if i == 11 and memcmp(low, "android-app", 11) == 0:
                uses_params = false
            if i + 2 < len and low[i + 1] == '/' and low[i + 2] == '/':
                after: cstr = low + i + 3
                alen: i32 = len - (i + 3)
                end: i32 = 0
                while end < alen and after[end] != '/' and after[end] != '?' and after[end] != '#':
                    end += 1
                netloc = after
                nlen = end
                rest = after + end
                rlen = alen - end
            else:
                rest = low + i + 1
                rlen = len - (i + 1)

    # Strip ?query, #fragment, and ;params (only after last '/' per urllib.parse._splitparams)
    path_len: i32 = 0
    last_slash: i32 = -1
    while path_len < rlen:
        ch: char = rest[path_len]
        if ch == '?' or ch == '#':
            break
        if ch == '/':
            last_slash = path_len
        path_len += 1
    if uses_params:
        scan_start: i32 = (last_slash + 1) if last_slash >= 0 else 0
        for si in range(scan_start, path_len):
            if rest[si] == ';':
                path_len = si
                break
    if path_len > 0 and rest[path_len - 1] == '/':
        path_len -= 1

    # Strip leading www. from netloc
    nl_off: i32 = 0
    if nlen >= 4 and memcmp(netloc, "www.", 4) == 0:
        nl_off = 4
    nl_final: i32 = nlen - nl_off
    if nl_final + path_len > 2040:
        path_len = 2040 - nl_final
        if path_len < 0:
            path_len = 0
    if nl_final > 0:
        memcpy(link_out, netloc + nl_off, usize(nl_final))
    if path_len > 0:
        memcpy(link_out + nl_final, rest, usize(path_len))
    link_out[nl_final + path_len] = '\0'
    val(link_len_out) = u32(nl_final + path_len)

    # Hostname for --skip check
    h_src: cstr = netloc if nlen > 0 else rest
    h_max: i32 = nlen if nlen > 0 else path_len
    h_end: i32 = 0
    while h_end < h_max and h_src[h_end] != '/' and h_src[h_end] != ':' and h_src[h_end] != '?' and h_src[h_end] != '#':
        h_end += 1
    if not has_scheme and h_end == 0:
        h_end = 0
    h_off: i32 = 0
    if h_end >= 4 and memcmp(h_src, "www.", 4) == 0:
        # Strip www. when another dot follows
        has_dot: bool = false
        for k in range(4, h_end):
            if h_src[k] == '.':
                has_dot = true
                break
        if has_dot:
            h_off = 4
    hl: i32 = h_end - h_off
    if hl > 255:
        hl = 255
    if hl > 0:
        memcpy(host_out, h_src + h_off, usize(hl))
    host_out[hl] = '\0'
    val(host_len_out) = u32(hl)

static inline def skip_pattern_matches(pattern: cstr, host: cstr, host_len: u32) -> bool:
    # Lowercase copies
    ph: char[260]
    hh: char[260]
    pi: usize = 0
    hi: usize = 0
    while pattern[pi] != '\0' and pi < 255:
        ch: u8 = u8(pattern[pi])
        if ch >= 'A' and ch <= 'Z':
            ch = u8(ch + 32)
        ph[pi] = char(ch)
        pi += 1
    ph[pi] = '\0'
    while hi < usize(host_len) and hi < 255:
        ch: u8 = u8(host[hi])
        if ch >= 'A' and ch <= 'Z':
            ch = u8(ch + 32)
        hh[hi] = char(ch)
        hi += 1
    hh[hi] = '\0'

    # Detect wildcard prefix
    base: cstr = ph
    wildcard: bool = false
    if ph[0] == '*' and ph[1] == '.':
        base = ph + 2
        wildcard = true
    elif ph[0] == '.':
        base = ph + 1
        wildcard = true
    elif ph[0] == '*':
        while base[0] == '*' or base[0] == '.':
            base += 1
        wildcard = true
    if base[0] == '\0':
        return false

    blen: usize = strlen(base)
    hlen: usize = strlen(hh)
    if not wildcard:
        return hlen == blen and memcmp(hh, base, blen) == 0
    # Wildcard matches subdomains only, not the bare domain itself.
    if hlen > blen and hh[hlen - blen - 1] == '.' and memcmp(hh + hlen - blen, base, blen) == 0:
        return true
    return false

static inline def refcache_get(c: addr[RefCache], raw: cstr, rlen: u32) -> addr[RefCacheEntry]:
    h: u64 = hash_bytes(raw, usize(rlen))
    slot: usize = usize(h) & c.mask
    while c.buckets[slot] != 0:
        idx: u32 = c.buckets[slot] - 1
        if c.entries[idx].hash == h and c.entries[idx].raw_len == rlen and (rlen == 0 or memcmp(c.entries[idx].raw, raw, usize(rlen)) == 0):
            return c.entries[idx].addr
        slot = (slot + 1) & c.mask

    # Lowercase raw into scratch buffer
    low: char[2048]
    clen: i32 = i32(rlen)
    if clen > 2047:
        clen = 2047
    for i in range(clen):
        ch: u8 = u8(raw[i])
        if ch >= 'A' and ch <= 'Z':
            low[i] = char(ch + 32)
        else:
            low[i] = char(ch)
    low[clen] = '\0'

    link_buf: char[2048]
    link_len: u32 = 0
    host_buf: char[260]
    host_len: u32 = 0
    parse_ref_link_and_host(low, clen, link_buf, link_len.addr, host_buf, host_len.addr)

    should_skip: bool = false
    for i in range(c.n_skips):
        if skip_pattern_matches(c.skips[i], host_buf, host_len):
            should_skip = true
            break

    if usize(c.count + 1) * 10 >= (c.mask + 1) * 7:
        refcache_rehash(c)
        slot = usize(h) & c.mask
        while c.buckets[slot] != 0:
            slot = (slot + 1) & c.mask
    if c.count == c.cap:
        c.cap *= 2
        c.entries = cast(addr[RefCacheEntry], realloc(c.entries, usize(c.cap) * sizeof(RefCacheEntry)))

    id: u32 = c.count
    c.count += 1
    c.entries[id].hash = h
    c.entries[id].raw = arena_strdup(c.arena, raw, usize(rlen))
    c.entries[id].raw_len = rlen
    c.entries[id].link = arena_strdup(c.arena, link_buf, usize(link_len))
    c.entries[id].link_len = link_len
    c.entries[id].skip = should_skip
    c.buckets[slot] = id + 1
    return c.entries[id].addr

# -------------------------------------------------------------------------
# Fast Date Parser & Cache (01/Jan/2022 -> 2022-01-01 Saturday)
# -------------------------------------------------------------------------

struct DateCacheEntry:
    raw: char[12]
    day_str: char[24]
    day_len: u32
    valid: bool

static g_date_cache: DateCacheEntry[256]

static def parse_month(m: cstr) -> i32:
    if m[0] == 'J':
        if m[1] == 'a' and m[2] == 'n':
            return 1
        if m[1] == 'u' and m[2] == 'n':
            return 6
        if m[1] == 'u' and m[2] == 'l':
            return 7
    elif m[0] == 'F':
        if m[1] == 'e' and m[2] == 'b':
            return 2
    elif m[0] == 'M':
        if m[1] == 'a' and m[2] == 'r':
            return 3
        if m[1] == 'a' and m[2] == 'y':
            return 5
    elif m[0] == 'A':
        if m[1] == 'p' and m[2] == 'r':
            return 4
        if m[1] == 'u' and m[2] == 'g':
            return 8
    elif m[0] == 'S' and m[1] == 'e' and m[2] == 'p':
        return 9
    elif m[0] == 'O' and m[1] == 'c' and m[2] == 't':
        return 10
    elif m[0] == 'N' and m[1] == 'o' and m[2] == 'v':
        return 11
    elif m[0] == 'D' and m[1] == 'e' and m[2] == 'c':
        return 12
    return 0

static inline def day_of_week(y: i32, m: i32, d: i32) -> i32:
    t: i32[12] = {0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4}
    if m < 3:
        y -= 1
    return (y + y / 4 - y / 100 + y / 400 + t[m - 1] + d) % 7

static inline def format_day(date_part: cstr, out_len: addr[u32]) -> cstr:
    h: u32 = u32(u8(date_part[0])) * 31 + u32(u8(date_part[1])) * 17 + u32(u8(date_part[3])) * 7 + u32(u8(date_part[4])) * 13 + u32(u8(date_part[10]))
    slot: usize = usize(h) & 255
    ent: addr[DateCacheEntry] = g_date_cache[slot].addr
    if ent.valid and memcmp(ent.raw, date_part, 11) == 0:
        val(out_len) = ent.day_len
        return ent.day_str
    dd: i32 = (date_part[0] - '0') * 10 + (date_part[1] - '0')
    mm: i32 = parse_month(date_part + 3)
    yyyy: i32 = (date_part[7] - '0') * 1000 + (date_part[8] - '0') * 100 + (date_part[9] - '0') * 10 + (date_part[10] - '0')
    wdays: cstr[7] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"}
    wd: i32 = day_of_week(yyyy, mm, dd)
    memcpy(ent.raw, date_part, 11)
    ent.raw[11] = '\0'
    n: i32 = snprintf(ent.day_str, sizeof(ent.day_str), "%04d-%02d-%02d %s", yyyy, mm, dd, wdays[wd])
    ent.day_len = u32(n)
    ent.valid = true
    val(out_len) = ent.day_len
    return ent.day_str

# -------------------------------------------------------------------------
# Combined & Common Log Line Scanner
# -------------------------------------------------------------------------

static inline def parse_log_line(line: cstr, len: i32,
                                 ip_out: addr[cstr], ip_len_out: addr[u32],
                                 date_out: addr[cstr],
                                 ref_out: addr[cstr], ref_len_out: addr[u32],
                                 ua_out: addr[cstr], ua_len_out: addr[u32]) -> bool:
    p: cstr = line
    end: cstr = line + len

    # Field 1: IP (`h`)
    sp: cstr = cast(cstr, memchr(p, ' ', usize(end - p)))
    if sp == nil:
        return false
    ip: cstr = p
    ip_len: u32 = u32(sp - p)
    p = sp + 1

    # Field 2: `l`
    sp = cast(cstr, memchr(p, ' ', usize(end - p)))
    if sp == nil:
        return false
    p = sp + 1

    # Field 3: `u`
    sp = cast(cstr, memchr(p, ' ', usize(end - p)))
    if sp == nil:
        return false
    p = sp + 1

    # Field 4: `[t]`
    if p >= end or p[0] != '[':
        return false
    rb: cstr = cast(cstr, memchr(p + 1, ']', usize(end - (p + 1))))
    if rb == nil or rb + 1 >= end or rb[1] != ' ':
        return false
    if rb - (p + 1) < 11:
        return false
    date_part: cstr = p + 1
    p = rb + 2

    # Field 5: `"r"`
    if p >= end or p[0] != '"':
        return false
    rq: cstr = cast(cstr, memchr(p + 1, '"', usize(end - (p + 1))))
    if rq == nil or rq + 1 >= end or rq[1] != ' ':
        return false
    p = rq + 2

    # Field 6: `s`
    sp = cast(cstr, memchr(p, ' ', usize(end - p)))
    if sp == nil:
        return false
    p = sp + 1

    # Field 7: `b` (followed by space for Combined, or end-of-field for Common)
    sp = cast(cstr, memchr(p, ' ', usize(end - p)))
    if sp != nil and sp + 1 < end and sp[1] == '"':
        p = sp + 2
        ref_q: cstr = cast(cstr, memchr(p, '"', usize(end - p)))
        if ref_q != nil and ref_q + 2 < end and ref_q[1] == ' ' and ref_q[2] == '"':
            ua_start: cstr = ref_q + 3
            ua_q: cstr = cast(cstr, memchr(ua_start, '"', usize(end - ua_start)))
            if ua_q != nil:
                val(ip_out) = ip
                val(ip_len_out) = ip_len
                val(date_out) = date_part
                val(ref_out) = p
                val(ref_len_out) = u32(ref_q - p)
                val(ua_out) = ua_start
                val(ua_len_out) = u32(ua_q - ua_start)
                return true

    # Common Log Format fallback (empty Referer and Useragent)
    val(ip_out) = ip
    val(ip_len_out) = ip_len
    val(date_out) = date_part
    val(ref_out) = ""
    val(ref_len_out) = 0
    val(ua_out) = ""
    val(ua_len_out) = 0
    return true

# -------------------------------------------------------------------------
# Sorting & Output (Console and HTML)
# -------------------------------------------------------------------------

static def cmp_key_asc(a: const any, b: const any) -> i32:
    ea: addr[const CatEntry] = cast(addr[const CatEntry], a)
    eb: addr[const CatEntry] = cast(addr[const CatEntry], b)
    return strcmp(ea.key, eb.key)

static def cmp_key_desc(a: const any, b: const any) -> i32:
    ea: addr[const CatEntry] = cast(addr[const CatEntry], a)
    eb: addr[const CatEntry] = cast(addr[const CatEntry], b)
    return strcmp(eb.key, ea.key)

static def cmp_count_asc(a: const any, b: const any) -> i32:
    ea: addr[const CatEntry] = cast(addr[const CatEntry], a)
    eb: addr[const CatEntry] = cast(addr[const CatEntry], b)
    if ea.count < eb.count:
        return -1
    if ea.count > eb.count:
        return 1
    if ea.order < eb.order:
        return -1
    if ea.order > eb.order:
        return 1
    return 0

static def cmp_count_desc(a: const any, b: const any) -> i32:
    ea: addr[const CatEntry] = cast(addr[const CatEntry], a)
    eb: addr[const CatEntry] = cast(addr[const CatEntry], b)
    if ea.count > eb.count:
        return -1
    if ea.count < eb.count:
        return 1
    if ea.order > eb.order:
        return -1
    if ea.order < eb.order:
        return 1
    return 0

static def console_print(days: addr[CatMap], browsers: addr[CatMap], systems: addr[CatMap],
                         bots: addr[CatMap], refs: addr[CatMap], hide: u32):
    max_val: u32 = 0
    maps: addr[CatMap][4] = {days, browsers, systems, refs}
    for m_i in range(4):
        m: addr[CatMap] = maps[m_i]
        for i: u32 in range(m.count):
            if m.entries[i].count > max_val:
                max_val = m.entries[i].count
    tabs: i32 = 1
    tmp: u32 = max_val
    while tmp >= 10:
        tmp /= 10
        tabs += 1

    padding: char[32]
    if tabs > 31:
        tabs = 31
    memset(padding, '-', usize(tabs))
    padding[tabs] = '\0'

    qsort(days.entries, usize(days.count), sizeof(CatEntry), cmp_key_asc)
    qsort(browsers.entries, usize(browsers.count), sizeof(CatEntry), cmp_count_asc)
    qsort(systems.entries, usize(systems.count), sizeof(CatEntry), cmp_count_asc)
    qsort(bots.entries, usize(bots.count), sizeof(CatEntry), cmp_count_asc)
    qsort(refs.entries, usize(refs.count), sizeof(CatEntry), cmp_count_asc)

    titles: cstr[5] = {"Days", "Browsers", "Operating Systems", "Bots", "Referrers"}
    all_maps: addr[CatMap][5] = {days, browsers, systems, bots, refs}
    for s_i in range(5):
        if s_i > 0:
            putchar('\n')
        printf("%s %s\n", padding, titles[s_i])
        m: addr[CatMap] = all_maps[s_i]
        for i: u32 in range(m.count):
            if m.entries[i].count > hide:
                printf("%*u %s\n", tabs, m.entries[i].count, m.entries[i].key)

static def fputs_striptags(s: cstr, fp: addr[FILE]):
    in_tag: bool = false
    p: cstr = s
    while val(p) != '\0':
        if val(p) == '<':
            in_tag = true
        elif val(p) == '>':
            in_tag = false
        elif not in_tag:
            fputc(val(p), fp)
        p += 1

static def generate_html(days: addr[CatMap], browsers: addr[CatMap], systems: addr[CatMap],
                         bots: addr[CatMap], refs: addr[CatMap], hide: u32, html_path: cstr):
    printf("Generating html... %s\n", html_path)
    fp: addr[FILE] = fopen(html_path, "w")
    if fp == nil:
        fprintf(stderr, "logparser error: cannot open '%s' for writing\n", html_path)
        exit(1)

    qsort(days.entries, usize(days.count), sizeof(CatEntry), cmp_key_desc)
    qsort(browsers.entries, usize(browsers.count), sizeof(CatEntry), cmp_count_desc)
    qsort(systems.entries, usize(systems.count), sizeof(CatEntry), cmp_count_desc)
    qsort(bots.entries, usize(bots.count), sizeof(CatEntry), cmp_count_desc)
    qsort(refs.entries, usize(refs.count), sizeof(CatEntry), cmp_count_desc)

    fputs("""<!doctype html>
<html>
<head>
    <title>Logparser</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        html { --black: black; --whitesmoke: #f0f0f0; --black: black; }
        @media (prefers-color-scheme: dark) {
            html { --white: black; --whitesmoke: #202020; --black: white; }
        }
        * { margin: 0; padding: 0; }
        body {
            background-color: var(--white);
            color: var(--black);
            font-family: Tahoma, Ubuntu, Cantarell, Oxygen, sans-serif;
            font-size: 13px;
            line-height: 20px;
        }
        sup { line-height: 0; }
        h3 sup { font-size: 11px; margin-left: 1px; }
        .section {
            margin: 0 auto;
            max-width: 480px;
            padding: 0 10px;
            padding-top: 10px;
        }
        .section:last-child { padding-bottom: 20px; }
        .section p {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .section span {
            float: left;
            margin-right: 10px;
            text-align: right;
            width: 20%;
        }
        .section .even {
            background-color: var(--whitesmoke); border-radius: 5px;
        }
    </style>
</head>
<body>
""", fp)

    titles: cstr[5] = {"Days", "Browsers", "Operating Systems", "Bots", "Referrers"}
    all_maps: addr[CatMap][5] = {days, browsers, systems, bots, refs}
    for s_i in range(5):
        m: addr[CatMap] = all_maps[s_i]
        fprintf(fp, "    <div class=\"section\">\n        <h3>%s<sup>%u</sup></h3>\n", titles[s_i], m.count)
        row: u32 = 0
        for i: u32 in range(m.count):
            if m.entries[i].count > hide:
                cls: cstr = "odd" if (row % 2 == 0) else "even"
                row += 1
                fprintf(fp, "                <p class=\"%s\">\n                    <span>%u</span> ", cls, m.entries[i].count)
                if s_i == 4:
                    fputs_striptags(m.entries[i].key, fp)
                else:
                    fputs(m.entries[i].key, fp)
                fputs("\n                </p>\n", fp)
        fputs("    </div>\n", fp)
    fputs("</body>\n</html>\n", fp)
    fclose(fp)

# -------------------------------------------------------------------------
# CLI Entry Point & Gzip Stream Processing
# -------------------------------------------------------------------------

static def print_usage(prog: cstr):
    printf("Usage: %s [options] <gz_path...>\n", prog)
    printf("  --hide <N>     Hide rows with <= N items\n")
    printf("  --html <file>  Write HTML report to file\n")
    printf("  --skip <list>  Comma-separated hostnames to skip from referrers\n")
    printf("  --drop <days>  Drop logs older than N days and rebuild log file\n")

def main(argc: i32, argv: addr[str]) -> i32:
    hide: u32 = 0
    html_path: cstr = ""
    skip_arg: cstr = ""
    drop_days: i32 = 0

    gz_paths: addr[cstr] = cast(addr[cstr], malloc(usize(argc) * sizeof(cstr)))
    n_paths: i32 = 0

    i: i32 = 1
    while i < argc:
        arg: cstr = argv[i]
        if strcmp(arg, "-h") == 0 or strcmp(arg, "--help") == 0:
            print_usage(argv[0])
            free(gz_paths)
            return 0
        elif strcmp(arg, "--hide") == 0 and i + 1 < argc:
            hide = u32(atoi(argv[i + 1]))
            i += 2
        elif strncmp(arg, "--hide=", 7) == 0:
            hide = u32(atoi(arg + 7))
            i += 1
        elif strcmp(arg, "--html") == 0 and i + 1 < argc:
            html_path = argv[i + 1]
            i += 2
        elif strncmp(arg, "--html=", 7) == 0:
            html_path = arg + 7
            i += 1
        elif strcmp(arg, "--skip") == 0 and i + 1 < argc:
            skip_arg = argv[i + 1]
            i += 2
        elif strncmp(arg, "--skip=", 7) == 0:
            skip_arg = arg + 7
            i += 1
        elif strcmp(arg, "--drop") == 0 and i + 1 < argc:
            drop_days = atoi(argv[i + 1])
            i += 2
        elif strncmp(arg, "--drop=", 7) == 0:
            drop_days = atoi(arg + 7)
            i += 1
        else:
            gz_paths[n_paths] = arg
            n_paths += 1
            i += 1

    if n_paths == 0:
        print_usage(argv[0])
        free(gz_paths)
        return 1

    zlib: ZlibApi
    if not zlib_load(zlib.addr):
        free(gz_paths)
        return 1

    arena: Arena
    arena_init(arena.addr, 1 << 20)

    # Parse --skip comma-separated hostnames
    skips: cstr[128]
    n_skips: i32 = 0
    if skip_arg[0] != '\0':
        sp: cstr = skip_arg
        while val(sp) != '\0' and n_skips < 128:
            comma: cstr = strchr(sp, ',')
            slen: usize = strlen(sp) if comma == nil else usize(comma - sp)
            if slen > 0:
                low_s: str = arena_strdup(arena.addr, sp, slen)
                for k: usize in range(slen):
                    if low_s[k] >= 'A' and low_s[k] <= 'Z':
                        low_s[k] += 32
                skips[n_skips] = low_s
                n_skips += 1
            if comma == nil:
                break
            sp = comma + 1

    cutoff: char[16]
    cutoff[0] = '\0'
    if drop_days > 0:
        now_t: time_t = time(nil) - cast(time_t, drop_days) * 86400
        tm_info: addr[struct tm] = localtime(now_t.addr)
        snprintf(cutoff, sizeof(cutoff), "%04d-%02d-%02d", tm_info.tm_year + 1900, tm_info.tm_mon + 1, tm_info.tm_mday)

    intern: StrInterner
    intern_init(intern.addr, arena.addr, 65536)

    uacache: UaCache
    uacache_init(uacache.addr, arena.addr, intern.addr)

    refcache: RefCache
    refcache_init(refcache.addr, arena.addr, skips, n_skips)

    days: CatMap
    browsers: CatMap
    systems: CatMap
    bots: CatMap
    refs: CatMap
    cat_init(days.addr, arena.addr, 512, 65536)
    cat_init(browsers.addr, arena.addr, 1024, 65536)
    cat_init(systems.addr, arena.addr, 512, 65536)
    cat_init(bots.addr, arena.addr, 2048, 65536)
    cat_init(refs.addr, arena.addr, 65536, 131072)

    chunk_cap: usize = 1 << 20
    buf: str = cast(str, malloc(chunk_cap + 1))
    kept: ByteBuf
    buf_init(kept.addr, 4096)

    for fi in range(n_paths):
        gz_path: cstr = gz_paths[fi]
        gz: any = zlib.open(gz_path, "rb")
        if gz == nil:
            fprintf(stderr, "logparser error: cannot open '%s'\n", gz_path)
            continue
        if zlib.buffer != nil:
            zlib.buffer(gz, 1 << 20)

        kept.len = 0
        dropped: bool = false
        carry: usize = 0

        while true:
            if carry >= chunk_cap:
                chunk_cap *= 2
                buf = cast(str, realloc(buf, chunk_cap + 1))
            n_read: i32 = zlib.read(gz, buf + carry, u32(chunk_cap - carry))
            if n_read < 0:
                fprintf(stderr, "logparser error: failed reading '%s'\n", gz_path)
                break
            total: usize = carry + usize(n_read)
            if total == 0:
                break

            pos: usize = 0
            while pos < total:
                nl: str = cast(str, memchr(buf + pos, '\n', total - pos))
                line_end: usize = total
                has_nl: bool = false
                if nl != nil:
                    line_end = usize(nl - buf)
                    has_nl = true
                elif n_read > 0:
                    break

                line_len: i32 = i32(line_end - pos)
                nl_extra: usize = 1 if has_nl else 0
                raw_len: usize = usize(line_len) + nl_extra
                if line_len > 0 and buf[pos + usize(line_len) - 1] == '\r':
                    line_len -= 1

                ip: cstr = nil
                ip_len: u32 = 0
                date_part: cstr = nil
                raw_ref: cstr = nil
                raw_ref_len: u32 = 0
                raw_ua: cstr = nil
                raw_ua_len: u32 = 0
                if parse_log_line(buf + pos, line_len, ip.addr, ip_len.addr, date_part.addr, raw_ref.addr, raw_ref_len.addr, raw_ua.addr, raw_ua_len.addr):
                    day_len: u32 = 0
                    day: cstr = format_day(date_part, day_len.addr)
                    skip_line: bool = false
                    if drop_days > 0:
                        if strncmp(day, cutoff, 10) < 0:
                            dropped = true
                            skip_line = true
                        else:
                            buf_append(kept.addr, buf + pos, raw_len)
                    if not skip_line:
                        ip_id: u32 = intern_str(intern.addr, ip, ip_len)
                        ua_ent: addr[UaCacheEntry] = uacache_get(uacache.addr, raw_ua, raw_ua_len)
                        if ua_ent.is_bot:
                            cat_add(bots.addr, ua_ent.browser, ua_ent.browser_len, ip_id)
                        else:
                            cat_add(days.addr, day, day_len, ip_id)
                            cat_add(browsers.addr, ua_ent.browser, ua_ent.browser_len, ip_id)
                            cat_add(systems.addr, ua_ent.os, ua_ent.os_len, ip_id)
                            ref_ent: addr[RefCacheEntry] = refcache_get(refcache.addr, raw_ref, raw_ref_len)
                            if not ref_ent.skip:
                                cat_add(refs.addr, ref_ent.link, ref_ent.link_len, ip_id)

                pos += raw_len

            carry = total - pos
            if carry > 0 and pos > 0:
                memmove(buf, buf + pos, carry)
            if n_read == 0:
                break

        zlib.close(gz)

        if dropped:
            gz_out: any = zlib.open(gz_path, "wb")
            if gz_out != nil:
                written: usize = 0
                while written < kept.len:
                    rem: usize = kept.len - written
                    chunk: u32 = u32(1 << 20) if rem > usize(1 << 20) else u32(rem)
                    zlib.write(gz_out, kept.data + written, chunk)
                    written += usize(chunk)
                zlib.close(gz_out)

    if html_path[0] != '\0':
        generate_html(days.addr, browsers.addr, systems.addr, bots.addr, refs.addr, hide, html_path)
    else:
        console_print(days.addr, browsers.addr, systems.addr, bots.addr, refs.addr, hide)

    free(buf)
    buf_free(kept.addr)
    cat_free(days.addr)
    cat_free(browsers.addr)
    cat_free(systems.addr)
    cat_free(bots.addr)
    cat_free(refs.addr)
    refcache_free(refcache.addr)
    uacache_free(uacache.addr)
    intern_free(intern.addr)
    arena_free(arena.addr)
    free(g_vm.curr)
    free(g_vm.next)
    free(g_vm.gen)
    free(gz_paths)
    return 0
