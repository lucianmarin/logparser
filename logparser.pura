# Logparser — Pura implementation
#
# Command line parser for Combined and Common log formats (Nginx default).
# Transpiles to ISO C11 via `pura` and compiles with zero external dependencies
# (loads system zlib dynamically via dlopen).
#
# Build & CLI usage:
#   pura --compile logparser.pura -o logparser
#   ./logparser logs/*.log.gz
#   ./logparser logs/moss.log.gz --hide 1 --skip "subreply.com" --html out.html

import ctype.h
import dlfcn.h
import stdbool.h
import stddef.h
import stdint.h
import stdio.h
import stdlib.h
import string.h
import time.h

# -------------------------------------------------------------------------
# Dynamic zlib Interface (works with `pura --compile` without `-lz`)
# -------------------------------------------------------------------------

typedef any (*GzOpenFn)(cstr, cstr)
typedef i32 (*GzBufferFn)(any, u32)
typedef i32 (*GzReadFn)(any, any, u32)
typedef i32 (*GzWriteFn)(any, cstr, u32)
typedef i32 (*GzCloseFn)(any)

struct ZlibApi:
    handle: any
    open: GzOpenFn
    buffer: GzBufferFn
    read: GzReadFn
    write: GzWriteFn
    close: GzCloseFn

static def zlib_load(z: addr[ZlibApi]) -> bool:
    libs: cstr[3] = {"libz.1.dylib", "libz.so.1", "libz.so"}
    z.handle = nil
    for i in range(3):
        z.handle = dlopen(libs[i], RTLD_LAZY)
        if z.handle != nil:
            break
    if z.handle == nil:
        fprintf(stderr, "logparser error: could not load zlib (%s)\n", dlerror())
        return false
    z.open = cast(GzOpenFn, dlsym(z.handle, "gzopen"))
    z.buffer = cast(GzBufferFn, dlsym(z.handle, "gzbuffer"))
    z.read = cast(GzReadFn, dlsym(z.handle, "gzread"))
    z.write = cast(GzWriteFn, dlsym(z.handle, "gzwrite"))
    z.close = cast(GzCloseFn, dlsym(z.handle, "gzclose"))
    if z.open == nil or z.read == nil or z.write == nil or z.close == nil:
        fprintf(stderr, "logparser error: missing zlib symbols\n")
        return false
    return true

# -------------------------------------------------------------------------
# Arena Allocator & Growable Byte Buffer
# -------------------------------------------------------------------------

struct ArenaBlock:
    next: addr[ArenaBlock]
    cap: usize
    used: usize
    data: u8[]

struct Arena:
    head: addr[ArenaBlock]
    block_size: usize

static def arena_init(a: addr[Arena], block_size: usize):
    a.head = nil
    a.block_size = block_size

static def arena_free(a: addr[Arena]):
    blk: addr[ArenaBlock] = a.head
    while blk != nil:
        nxt: addr[ArenaBlock] = blk.next
        free(blk)
        blk = nxt
    a.head = nil

static inline def arena_alloc(a: addr[Arena], size: usize) -> any:
    aligned: usize = (size + 7) & ~usize(7)
    if aligned == 0:
        aligned = 8
    blk: addr[ArenaBlock] = a.head
    if blk == nil or blk.cap - blk.used < aligned:
        cap: usize = a.block_size
        if aligned > cap:
            cap = aligned
        blk = cast(addr[ArenaBlock], malloc(sizeof(ArenaBlock) + cap))
        if blk == nil:
            fprintf(stderr, "logparser error: out of memory\n")
            exit(1)
        blk.cap = cap
        blk.used = 0
        blk.next = a.head
        a.head = blk
    p: any = blk.data + blk.used
    blk.used += aligned
    return p

static def arena_strdup(a: addr[Arena], s: cstr, n: usize) -> str:
    p: str = cast(str, arena_alloc(a, n + 1))
    if n > 0:
        memcpy(p, s, n)
    p[n] = '\0'
    return p

struct ByteBuf:
    data: str
    len: usize
    cap: usize

static def buf_init(b: addr[ByteBuf], cap: usize):
    if cap < 256:
        cap = 256
    b.data = cast(str, malloc(cap))
    b.len = 0
    b.cap = cap
    b.data[0] = '\0'

static def buf_free(b: addr[ByteBuf]):
    free(b.data)
    b.data = nil
    b.len = 0
    b.cap = 0

static inline def buf_reserve(b: addr[ByteBuf], extra: usize):
    if b.len + extra + 1 <= b.cap:
        return
    ncap: usize = b.cap * 2
    while ncap < b.len + extra + 1:
        ncap *= 2
    b.data = cast(str, realloc(b.data, ncap))
    b.cap = ncap

static inline def buf_append(b: addr[ByteBuf], s: cstr, n: usize):
    if n == 0:
        return
    buf_reserve(b, n)
    memcpy(b.data + b.len, s, n)
    b.len += n
    b.data[b.len] = '\0'

# -------------------------------------------------------------------------
# Hashing, String Interning, and Category Unique-IP Sets
# -------------------------------------------------------------------------

static inline def hash_bytes(s: cstr, n: usize) -> u64:
    h: u64 = 14695981039346656037ULL
    for i: usize in range(n):
        h ^= u64(u8(s[i]))
        h *= 1099511628211ULL
    if h == 0:
        h = 1
    return h

struct StrEntry:
    hash: u64
    s: cstr
    len: u32

struct StrInterner:
    buckets: addr[u32]
    mask: usize
    entries: addr[StrEntry]
    count: u32
    cap: u32
    arena: addr[Arena]

static def intern_init(t: addr[StrInterner], arena: addr[Arena], init_buckets: usize):
    t.arena = arena
    t.mask = init_buckets - 1
    t.buckets = cast(addr[u32], calloc(init_buckets, sizeof(u32)))
    t.cap = 1024
    t.count = 0
    t.entries = cast(addr[StrEntry], malloc(usize(t.cap) * sizeof(StrEntry)))

static def intern_free(t: addr[StrInterner]):
    free(t.buckets)
    free(t.entries)

static def intern_rehash(t: addr[StrInterner]):
    new_n: usize = (t.mask + 1) * 2
    nb: addr[u32] = cast(addr[u32], calloc(new_n, sizeof(u32)))
    nmask: usize = new_n - 1
    for idx: u32 in range(t.count):
        slot: usize = usize(t.entries[idx].hash) & nmask
        while nb[slot] != 0:
            slot = (slot + 1) & nmask
        nb[slot] = idx + 1
    free(t.buckets)
    t.buckets = nb
    t.mask = nmask

static inline def intern_str(t: addr[StrInterner], s: cstr, n: u32) -> u32:
    h: u64 = hash_bytes(s, usize(n))
    slot: usize = usize(h) & t.mask
    while t.buckets[slot] != 0:
        idx: u32 = t.buckets[slot] - 1
        if t.entries[idx].hash == h and t.entries[idx].len == n and (n == 0 or memcmp(t.entries[idx].s, s, usize(n)) == 0):
            return idx
        slot = (slot + 1) & t.mask
    if usize(t.count + 1) * 10 >= (t.mask + 1) * 7:
        intern_rehash(t)
        slot = usize(h) & t.mask
        while t.buckets[slot] != 0:
            slot = (slot + 1) & t.mask
    if t.count == t.cap:
        t.cap *= 2
        t.entries = cast(addr[StrEntry], realloc(t.entries, usize(t.cap) * sizeof(StrEntry)))
    id: u32 = t.count
    t.count += 1
    t.entries[id].hash = h
    t.entries[id].s = arena_strdup(t.arena, s, usize(n))
    t.entries[id].len = n
    t.buckets[slot] = id + 1
    return id

struct U64Set:
    keys: addr[u64]
    mask: usize
    count: usize

static def u64set_init(s: addr[U64Set], init_cap: usize):
    s.mask = init_cap - 1
    s.keys = cast(addr[u64], calloc(init_cap, sizeof(u64)))
    s.count = 0

static def u64set_free(s: addr[U64Set]):
    free(s.keys)

static inline def mix64(k: u64) -> u64:
    k ^= k >> 33
    k *= 0xff51afd7ed558ccdULL
    k ^= k >> 33
    k *= 0xc4ceb9fe1a85ec53ULL
    k ^= k >> 33
    return k

static def u64set_rehash(s: addr[U64Set]):
    new_n: usize = (s.mask + 1) * 2
    nk: addr[u64] = cast(addr[u64], calloc(new_n, sizeof(u64)))
    nmask: usize = new_n - 1
    old_n: usize = s.mask + 1
    for i: usize in range(old_n):
        k: u64 = s.keys[i]
        if k != 0:
            slot: usize = usize(mix64(k)) & nmask
            while nk[slot] != 0:
                slot = (slot + 1) & nmask
            nk[slot] = k
    free(s.keys)
    s.keys = nk
    s.mask = nmask

static inline def u64set_insert(s: addr[U64Set], raw_key: u64) -> bool:
    k: u64 = raw_key + 1
    if (s.count + 1) * 10 >= (s.mask + 1) * 7:
        u64set_rehash(s)
    slot: usize = usize(mix64(k)) & s.mask
    while s.keys[slot] != 0:
        if s.keys[slot] == k:
            return false
        slot = (slot + 1) & s.mask
    s.keys[slot] = k
    s.count += 1
    return true

struct CatEntry:
    hash: u64
    key: cstr
    len: u32
    count: u32
    order: u32

struct CatMap:
    buckets: addr[u32]
    mask: usize
    entries: addr[CatEntry]
    count: u32
    cap: u32
    pairs: U64Set
    arena: addr[Arena]

static def cat_init(m: addr[CatMap], arena: addr[Arena], init_buckets: usize, init_pairs: usize):
    m.arena = arena
    m.mask = init_buckets - 1
    m.buckets = cast(addr[u32], calloc(init_buckets, sizeof(u32)))
    m.cap = 256
    m.count = 0
    m.entries = cast(addr[CatEntry], malloc(usize(m.cap) * sizeof(CatEntry)))
    u64set_init(m.pairs.addr, init_pairs)

static def cat_free(m: addr[CatMap]):
    free(m.buckets)
    free(m.entries)
    u64set_free(m.pairs.addr)

static def cat_rehash(m: addr[CatMap]):
    new_n: usize = (m.mask + 1) * 2
    nb: addr[u32] = cast(addr[u32], calloc(new_n, sizeof(u32)))
    nmask: usize = new_n - 1
    for idx: u32 in range(m.count):
        slot: usize = usize(m.entries[idx].hash) & nmask
        while nb[slot] != 0:
            slot = (slot + 1) & nmask
        nb[slot] = idx + 1
    free(m.buckets)
    m.buckets = nb
    m.mask = nmask

static inline def cat_add(m: addr[CatMap], key: cstr, klen: u32, ip_id: u32):
    h: u64 = hash_bytes(key, usize(klen))
    slot: usize = usize(h) & m.mask
    cat_id: u32 = 0
    found: bool = false
    while m.buckets[slot] != 0:
        idx: u32 = m.buckets[slot] - 1
        if m.entries[idx].hash == h and m.entries[idx].len == klen and (klen == 0 or memcmp(m.entries[idx].key, key, usize(klen)) == 0):
            cat_id = idx
            found = true
            break
        slot = (slot + 1) & m.mask
    if not found:
        if usize(m.count + 1) * 10 >= (m.mask + 1) * 7:
            cat_rehash(m)
            slot = usize(h) & m.mask
            while m.buckets[slot] != 0:
                slot = (slot + 1) & m.mask
        if m.count == m.cap:
            m.cap *= 2
            m.entries = cast(addr[CatEntry], realloc(m.entries, usize(m.cap) * sizeof(CatEntry)))
        cat_id = m.count
        m.count += 1
        m.entries[cat_id].hash = h
        m.entries[cat_id].key = arena_strdup(m.arena, key, usize(klen))
        m.entries[cat_id].len = klen
        m.entries[cat_id].count = 0
        m.entries[cat_id].order = cat_id
        m.buckets[slot] = cat_id + 1
    pair: u64 = (u64(cat_id) << 32) | u64(ip_id)
    if u64set_insert(m.pairs.addr, pair):
        m.entries[cat_id].count += 1

# -------------------------------------------------------------------------
# Compact Pike VM Regex Engine for ua-parser Rules
# -------------------------------------------------------------------------

enum ReOp:
    OP_CHAR = 0
    OP_ANY = 1
    OP_CLASS = 2
    OP_BOL = 3
    OP_EOL = 4
    OP_WB = 5
    OP_SPLIT = 6
    OP_JMP = 7
    OP_SAVE = 8
    OP_MATCH = 9

struct ReInst:
    op: u8
    arg: u8
    x: i32
    y: i32

struct ReClass:
    bits: u64[4]

struct ReProg:
    insts: addr[ReInst]
    n_inst: i32
    classes: addr[ReClass]
    num_cc: i32
    icase: bool
    anchored: bool

struct ReBuilder:
    insts: addr[ReInst]
    n_inst: i32
    cap_inst: i32
    classes: addr[ReClass]
    num_cc: i32
    cap_cc: i32
    pat: cstr
    len: i32
    pos: i32
    icase: bool
    next_cap: i32

static def rb_emit(b: addr[ReBuilder], op: u8, arg: u8, x: i32, y: i32) -> i32:
    if b.n_inst == b.cap_inst:
        if b.cap_inst == 0:
            b.cap_inst = 256
        else:
            b.cap_inst *= 2
        b.insts = cast(addr[ReInst], realloc(b.insts, usize(b.cap_inst) * sizeof(ReInst)))
    id: i32 = b.n_inst
    b.n_inst += 1
    b.insts[id].op = op
    b.insts[id].arg = arg
    b.insts[id].x = x
    b.insts[id].y = y
    return id

static def rb_add_class(b: addr[ReBuilder], cc: addr[ReClass]) -> i32:
    if b.num_cc == b.cap_cc:
        if b.cap_cc == 0:
            b.cap_cc = 32
        else:
            b.cap_cc *= 2
        b.classes = cast(addr[ReClass], realloc(b.classes, usize(b.cap_cc) * sizeof(ReClass)))
    id: i32 = b.num_cc
    b.num_cc += 1
    b.classes[id] = val(cc)
    return id

static inline def cc_set(cc: addr[ReClass], ch: u8):
    cc.bits[ch >> 6] |= (u64(1) << (ch & 63))

static inline def cc_get(cc: addr[ReClass], ch: u8) -> bool:
    return ((cc.bits[ch >> 6] >> (ch & 63)) & u64(1)) != 0

static def cc_add_builtin(cc: addr[ReClass], code: char):
    if code == 'd':
        for c in range('0', '9' + 1):
            cc_set(cc, u8(c))
    elif code == 'w':
        for c in range('0', '9' + 1):
            cc_set(cc, u8(c))
        for c in range('A', 'Z' + 1):
            cc_set(cc, u8(c))
        for c in range('a', 'z' + 1):
            cc_set(cc, u8(c))
        cc_set(cc, u8('_'))
    elif code == 's':
        cc_set(cc, u8(' '))
        cc_set(cc, u8('\t'))
        cc_set(cc, u8('\n'))
        cc_set(cc, u8('\r'))
        cc_set(cc, u8('\f'))
        cc_set(cc, u8('\v'))
    elif code == 'S':
        for c in range(256):
            if c != ' ' and c != '\t' and c != '\n' and c != '\r' and c != '\f' and c != '\v':
                cc_set(cc, u8(c))

static def rb_parse_alt(b: addr[ReBuilder])

static def rb_parse_class(b: addr[ReBuilder]):
    cc: ReClass
    memset(cc.addr, 0, sizeof(ReClass))
    neg: bool = false
    b.pos += 1
    if b.pos < b.len and b.pat[b.pos] == '^':
        neg = true
        b.pos += 1
    first: bool = true
    while b.pos < b.len:
        ch: char = b.pat[b.pos]
        if ch == ']' and not first:
            b.pos += 1
            break
        first = false
        if ch == '\\' and b.pos + 1 < b.len:
            esc: char = b.pat[b.pos + 1]
            b.pos += 2
            if esc == 'd' or esc == 'w' or esc == 's' or esc == 'S':
                cc_add_builtin(cc.addr, esc)
                continue
            ch = esc
        else:
            b.pos += 1
        # Check for range `a-z`
        if b.pos + 1 < b.len and b.pat[b.pos] == '-' and b.pat[b.pos + 1] != ']':
            b.pos += 1
            hi: char = b.pat[b.pos]
            if hi == '\\' and b.pos + 1 < b.len:
                hi = b.pat[b.pos + 1]
                b.pos += 2
            else:
                b.pos += 1
            lo_u: i32 = i32(u8(ch))
            hi_u: i32 = i32(u8(hi))
            for k in range(lo_u, hi_u + 1):
                cc_set(cc.addr, u8(k))
        else:
            cc_set(cc.addr, u8(ch))
    if b.icase:
        for c in range('A', 'Z' + 1):
            lc: u8 = u8(c + 32)
            if cc_get(cc.addr, u8(c)) or cc_get(cc.addr, lc):
                cc_set(cc.addr, u8(c))
                cc_set(cc.addr, lc)
    if neg:
        for w in range(4):
            cc.bits[w] = ~cc.bits[w]
    cid: i32 = rb_add_class(b, cc.addr)
    rb_emit(b, u8(OP_CLASS), 0, cid, 0)

static def rb_parse_atom(b: addr[ReBuilder]) -> bool:
    if b.pos >= b.len:
        return false
    c: char = b.pat[b.pos]
    if c == '|' or c == ')':
        return false
    if c == '(':
        b.pos += 1
        capturing: bool = true
        if b.pos + 1 < b.len and b.pat[b.pos] == '?' and b.pat[b.pos + 1] == ':':
            capturing = false
            b.pos += 2
        cap_id: i32 = 0
        if capturing:
            b.next_cap += 1
            cap_id = b.next_cap
        if cap_id == 1:
            rb_emit(b, u8(OP_SAVE), 0, 0, 0)
        rb_parse_alt(b)
        if b.pos < b.len and b.pat[b.pos] == ')':
            b.pos += 1
        if cap_id == 1:
            rb_emit(b, u8(OP_SAVE), 1, 0, 0)
        return true
    if c == '[':
        rb_parse_class(b)
        return true
    if c == '^':
        b.pos += 1
        rb_emit(b, u8(OP_BOL), 0, 0, 0)
        return true
    if c == '$':
        b.pos += 1
        rb_emit(b, u8(OP_EOL), 0, 0, 0)
        return true
    if c == '.':
        b.pos += 1
        rb_emit(b, u8(OP_ANY), 0, 0, 0)
        return true
    if c == '\\' and b.pos + 1 < b.len:
        esc: char = b.pat[b.pos + 1]
        b.pos += 2
        if esc == 'b':
            rb_emit(b, u8(OP_WB), 0, 0, 0)
        elif esc == 'd' or esc == 'w' or esc == 's' or esc == 'S':
            cc: ReClass
            memset(cc.addr, 0, sizeof(ReClass))
            cc_add_builtin(cc.addr, esc)
            cid: i32 = rb_add_class(b, cc.addr)
            rb_emit(b, u8(OP_CLASS), 0, cid, 0)
        else:
            ch_v: u8 = u8(esc)
            if b.icase and ch_v >= 'A' and ch_v <= 'Z':
                ch_v += 32
            rb_emit(b, u8(OP_CHAR), ch_v, 0, 0)
        return true
    b.pos += 1
    ch_v: u8 = u8(c)
    if b.icase and ch_v >= 'A' and ch_v <= 'Z':
        ch_v += 32
    rb_emit(b, u8(OP_CHAR), ch_v, 0, 0)
    return true

static def rb_parse_quant(b: addr[ReBuilder]) -> bool:
    atom_pat_pos: i32 = b.pos
    saved_cap: i32 = b.next_cap
    start_pc: i32 = b.n_inst
    if not rb_parse_atom(b):
        return false
    atom_end_pat: i32 = b.pos
    if b.pos >= b.len:
        return true
    q: char = b.pat[b.pos]
    if q == '*' or q == '+' or q == '?':
        b.pos += 1
        nongreedy: bool = false
        if b.pos < b.len and b.pat[b.pos] == '?':
            nongreedy = true
            b.pos += 1
        end_pc: i32 = b.n_inst
        atom_len: i32 = end_pc - start_pc
        if q == '+':
            sp_pc: i32 = rb_emit(b, u8(OP_SPLIT), 0, 0, 0)
            after_pc: i32 = b.n_inst
            b.insts[sp_pc].x = (nongreedy ? after_pc : start_pc)
            b.insts[sp_pc].y = (nongreedy ? start_pc : after_pc)
        elif q == '?':
            # Make room at start_pc for SPLIT
            rb_emit(b, u8(OP_JMP), 0, 0, 0)
            for k in range(atom_len - 1, -1, -1):
                b.insts[start_pc + 1 + k] = b.insts[start_pc + k]
                if b.insts[start_pc + 1 + k].op == OP_SPLIT or b.insts[start_pc + 1 + k].op == OP_JMP:
                    b.insts[start_pc + 1 + k].x += 1
                    if b.insts[start_pc + 1 + k].op == OP_SPLIT:
                        b.insts[start_pc + 1 + k].y += 1
            after_pc: i32 = b.n_inst
            b.insts[start_pc].op = u8(OP_SPLIT)
            b.insts[start_pc].x = (nongreedy ? after_pc : (start_pc + 1))
            b.insts[start_pc].y = (nongreedy ? (start_pc + 1) : after_pc)
        else:
            # `*` -> SPLIT + atom + JMP(SPLIT)
            rb_emit(b, u8(OP_JMP), 0, 0, 0)
            for k in range(atom_len - 1, -1, -1):
                b.insts[start_pc + 1 + k] = b.insts[start_pc + k]
                if b.insts[start_pc + 1 + k].op == OP_SPLIT or b.insts[start_pc + 1 + k].op == OP_JMP:
                    b.insts[start_pc + 1 + k].x += 1
                    if b.insts[start_pc + 1 + k].op == OP_SPLIT:
                        b.insts[start_pc + 1 + k].y += 1
            jmp_pc: i32 = rb_emit(b, u8(OP_JMP), 0, start_pc, 0)
            after_pc: i32 = jmp_pc + 1
            b.insts[start_pc].op = u8(OP_SPLIT)
            b.insts[start_pc].x = (nongreedy ? after_pc : (start_pc + 1))
            b.insts[start_pc].y = (nongreedy ? (start_pc + 1) : after_pc)
        return true
    if q == '{':
        p: i32 = b.pos + 1
        if p < b.len and b.pat[p] >= '0' and b.pat[p] <= '9':
            min_r: i32 = 0
            while p < b.len and b.pat[p] >= '0' and b.pat[p] <= '9':
                min_r = min_r * 10 + (b.pat[p] - '0')
                p += 1
            has_comma: bool = false
            max_r: i32 = min_r
            if p < b.len and b.pat[p] == ',':
                has_comma = true
                p += 1
                if p < b.len and b.pat[p] >= '0' and b.pat[p] <= '9':
                    max_r = 0
                    while p < b.len and b.pat[p] >= '0' and b.pat[p] <= '9':
                        max_r = max_r * 10 + (b.pat[p] - '0')
                        p += 1
                else:
                    max_r = -1
            if p < b.len and b.pat[p] == '}':
                p += 1
                nongreedy: bool = false
                if p < b.len and b.pat[p] == '?':
                    nongreedy = true
                    p += 1
                # Roll back the first copy and emit exact repetitions
                b.n_inst = start_pc
                b.next_cap = saved_cap
                for rep_i in range(min_r):
                    b.pos = atom_pat_pos
                    b.next_cap = saved_cap
                    rb_parse_atom(b)
                if max_r == -1:
                    # {min_r,}
                    loop_s: i32 = rb_emit(b, u8(OP_SPLIT), 0, 0, 0)
                    body_s: i32 = b.n_inst
                    b.pos = atom_pat_pos
                    b.next_cap = saved_cap
                    rb_parse_atom(b)
                    rb_emit(b, u8(OP_JMP), 0, loop_s, 0)
                    after_l: i32 = b.n_inst
                    b.insts[loop_s].x = (nongreedy ? after_l : body_s)
                    b.insts[loop_s].y = (nongreedy ? body_s : after_l)
                elif has_comma and max_r > min_r:
                    opt_n: i32 = max_r - min_r
                    for opt_i in range(opt_n):
                        sp_p: i32 = rb_emit(b, u8(OP_SPLIT), 0, 0, 0)
                        body_p: i32 = b.n_inst
                        b.pos = atom_pat_pos
                        b.next_cap = saved_cap
                        rb_parse_atom(b)
                        after_p: i32 = b.n_inst
                        b.insts[sp_p].x = (nongreedy ? after_p : body_p)
                        b.insts[sp_p].y = (nongreedy ? body_p : after_p)
                b.pos = p
                return true
    return true

static def rb_parse_seq(b: addr[ReBuilder]):
    while rb_parse_quant(b):
        pass

static def rb_parse_alt(b: addr[ReBuilder]):
    start_pc: i32 = b.n_inst
    rb_parse_seq(b)
    if b.pos >= b.len or b.pat[b.pos] != '|':
        return
    # Collect branch start/end JMP fixups
    jmp_fixups: i32[512]
    n_fix: i32 = 0
    while b.pos < b.len and b.pat[b.pos] == '|':
        b.pos += 1
        # Insert SPLIT before start_pc
        branch_len: i32 = b.n_inst - start_pc
        rb_emit(b, u8(OP_JMP), 0, 0, 0)
        for k in range(branch_len - 1, -1, -1):
            b.insts[start_pc + 1 + k] = b.insts[start_pc + k]
            if b.insts[start_pc + 1 + k].op == OP_SPLIT or b.insts[start_pc + 1 + k].op == OP_JMP:
                b.insts[start_pc + 1 + k].x += 1
                if b.insts[start_pc + 1 + k].op == OP_SPLIT:
                    b.insts[start_pc + 1 + k].y += 1
        for f_i in range(n_fix):
            jmp_fixups[f_i] += 1
        jmp_pc: i32 = rb_emit(b, u8(OP_JMP), 0, 0, 0)
        if n_fix < 512:
            jmp_fixups[n_fix] = jmp_pc
            n_fix += 1
        b.insts[start_pc].op = u8(OP_SPLIT)
        b.insts[start_pc].x = start_pc + 1
        b.insts[start_pc].y = b.n_inst
        rb_parse_seq(b)
    after_pc: i32 = b.n_inst
    for f_i in range(n_fix):
        b.insts[jmp_fixups[f_i]].x = after_pc

static def compile_regex(arena: addr[Arena], pat: cstr, icase: bool) -> addr[ReProg]:
    b: ReBuilder
    memset(b.addr, 0, sizeof(ReBuilder))
    b.pat = pat
    b.len = i32(strlen(pat))
    b.icase = icase
    rb_parse_alt(b.addr)
    rb_emit(b.addr, u8(OP_MATCH), 0, 0, 0)

    prog: addr[ReProg] = cast(addr[ReProg], arena_alloc(arena, sizeof(ReProg)))
    prog.n_inst = b.n_inst
    prog.insts = cast(addr[ReInst], arena_alloc(arena, usize(b.n_inst) * sizeof(ReInst)))
    memcpy(prog.insts, b.insts, usize(b.n_inst) * sizeof(ReInst))
    prog.num_cc = b.num_cc
    if b.num_cc > 0:
        prog.classes = cast(addr[ReClass], arena_alloc(arena, usize(b.num_cc) * sizeof(ReClass)))
        memcpy(prog.classes, b.classes, usize(b.num_cc) * sizeof(ReClass))
    else:
        prog.classes = nil
    prog.icase = icase
    # Check if top-level anchored with ^ and no top-level |
    anchored: bool = false
    if b.len > 0 and pat[0] == '^':
        anchored = true
        depth: i32 = 0
        in_cc: bool = false
        for i in range(b.len):
            ch: char = pat[i]
            if ch == '\\':
                continue
            if ch == '[' and not in_cc:
                in_cc = true
            elif ch == ']' and in_cc:
                in_cc = false
            elif not in_cc:
                if ch == '(':
                    depth += 1
                elif ch == ')' and depth > 0:
                    depth -= 1
                elif ch == '|' and depth == 0:
                    anchored = false
                    break
    prog.anchored = anchored
    free(b.insts)
    free(b.classes)
    return prog

struct VmThread:
    pc: i32
    s1: i32
    e1: i32

struct VmScratch:
    curr: addr[VmThread]
    next: addr[VmThread]
    gen: addr[u32]
    cur_gen: u32
    cap: i32

static g_vm: VmScratch

static def vm_ensure(n_inst: i32):
    if n_inst <= g_vm.cap:
        return
    ncap: i32 = 1024 if g_vm.cap == 0 else g_vm.cap * 2
    while ncap < n_inst:
        ncap *= 2
    g_vm.curr = cast(addr[VmThread], realloc(g_vm.curr, usize(ncap) * sizeof(VmThread)))
    g_vm.next = cast(addr[VmThread], realloc(g_vm.next, usize(ncap) * sizeof(VmThread)))
    g_vm.gen = cast(addr[u32], realloc(g_vm.gen, usize(ncap) * sizeof(u32)))
    memset(g_vm.gen, 0, usize(ncap) * sizeof(u32))
    g_vm.cap = ncap

static inline def is_word_ch(c: u8) -> bool:
    return (c >= '0' and c <= '9') or (c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z') or c == '_'

static inline def is_word_boundary(s: cstr, len: i32, pos: i32) -> bool:
    left: bool = false if pos <= 0 else is_word_ch(u8(s[pos - 1]))
    right: bool = false if pos >= len else is_word_ch(u8(s[pos]))
    return left != right

static def vm_add_thread(prog: addr[ReProg], list: addr[VmThread], n_list: addr[i32],
                         s: cstr, len: i32, pos: i32, pc: i32, s1: i32, e1: i32,
                         matched: addr[bool], best_s1: addr[i32], best_e1: addr[i32]):
    if g_vm.gen[pc] == g_vm.cur_gen:
        return
    g_vm.gen[pc] = g_vm.cur_gen
    inst: ReInst = prog.insts[pc]
    if inst.op == OP_SPLIT:
        vm_add_thread(prog, list, n_list, s, len, pos, inst.x, s1, e1, matched, best_s1, best_e1)
        if not val(matched):
            vm_add_thread(prog, list, n_list, s, len, pos, inst.y, s1, e1, matched, best_s1, best_e1)
        return
    if inst.op == OP_JMP:
        vm_add_thread(prog, list, n_list, s, len, pos, inst.x, s1, e1, matched, best_s1, best_e1)
        return
    if inst.op == OP_SAVE:
        if inst.arg == 0:
            vm_add_thread(prog, list, n_list, s, len, pos, pc + 1, pos, e1, matched, best_s1, best_e1)
        else:
            vm_add_thread(prog, list, n_list, s, len, pos, pc + 1, s1, pos, matched, best_s1, best_e1)
        return
    if inst.op == OP_BOL:
        if pos == 0:
            vm_add_thread(prog, list, n_list, s, len, pos, pc + 1, s1, e1, matched, best_s1, best_e1)
        return
    if inst.op == OP_EOL:
        if pos == len:
            vm_add_thread(prog, list, n_list, s, len, pos, pc + 1, s1, e1, matched, best_s1, best_e1)
        return
    if inst.op == OP_WB:
        if is_word_boundary(s, len, pos):
            vm_add_thread(prog, list, n_list, s, len, pos, pc + 1, s1, e1, matched, best_s1, best_e1)
        return
    if inst.op == OP_MATCH:
        val(matched) = true
        val(best_s1) = s1
        val(best_e1) = e1
        return
    idx: i32 = val(n_list)
    val(n_list) = idx + 1
    list[idx].pc = pc
    list[idx].s1 = s1
    list[idx].e1 = e1

static def vm_exec(prog: addr[ReProg], s: cstr, len: i32, out_s1: addr[i32], out_e1: addr[i32]) -> bool:
    vm_ensure(prog.n_inst)
    n_curr: i32 = 0
    n_next: i32 = 0
    matched: bool = false
    best_s1: i32 = -1
    best_e1: i32 = -1

    g_vm.cur_gen += 1
    if g_vm.cur_gen == 0:
        memset(g_vm.gen, 0, usize(g_vm.cap) * sizeof(u32))
        g_vm.cur_gen = 1
    vm_add_thread(prog, g_vm.curr, n_curr.addr, s, len, 0, 0, -1, -1, matched.addr, best_s1.addr, best_e1.addr)

    for pos in range(len):
        if n_curr == 0:
            if prog.anchored:
                break
        ch: u8 = u8(s[pos])
        ch_low: u8 = (ch + 32) if (prog.icase and ch >= 'A' and ch <= 'Z') else ch
        n_next = 0
        g_vm.cur_gen += 1
        if g_vm.cur_gen == 0:
            memset(g_vm.gen, 0, usize(g_vm.cap) * sizeof(u32))
            g_vm.cur_gen = 1
        step_matched: bool = false
        for ti in range(n_curr):
            t: VmThread = g_vm.curr[ti]
            inst: ReInst = prog.insts[t.pc]
            ok: bool = false
            if inst.op == OP_CHAR:
                if prog.icase:
                    ok = (ch_low == inst.arg)
                else:
                    ok = (ch == inst.arg)
            elif inst.op == OP_ANY:
                ok = (ch != '\n')
            elif inst.op == OP_CLASS:
                ok = cc_get(prog.classes[inst.x].addr, ch)
            if ok:
                vm_add_thread(prog, g_vm.next, n_next.addr, s, len, pos + 1, t.pc + 1, t.s1, t.e1, step_matched.addr, best_s1.addr, best_e1.addr)
                if step_matched:
                    matched = true
                    break
        if not matched and not prog.anchored:
            vm_add_thread(prog, g_vm.next, n_next.addr, s, len, pos + 1, 0, -1, -1, step_matched.addr, best_s1.addr, best_e1.addr)
            if step_matched:
                matched = true
        # Swap curr and next
        tmp: addr[VmThread] = g_vm.curr
        g_vm.curr = g_vm.next
        g_vm.next = tmp
        n_curr = n_next
        if n_curr == 0 and matched:
            break

    val(out_s1) = best_s1
    val(out_e1) = best_e1
    return matched

# -------------------------------------------------------------------------
# ua-parser Rules, Hint Prefilter, and Memoized User-Agent Classifier
# -------------------------------------------------------------------------

struct HintSlice:
    ptr: cstr
    len: i32
    bg0: u16
    bg1: u16

struct UaRule:
    pattern: cstr
    rep: cstr
    hint: cstr
    hint_len: u8
    any_hints: cstr
    icase: bool
    prog: addr[ReProg]
    slices: addr[HintSlice]
    n_slices: i32

